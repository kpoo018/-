<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggle_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="#BB86FC" />
    </LinearLayout>

    <!-- 설정 패널. 서버 주소가 없으면 처음에 펼쳐서 보여준다. -->
    <ScrollView
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/permission_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2A2A3A"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_title"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_body"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/open_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_button" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translator"
                android:textColor="#CCCCCC" />

            <RadioGroup
                android:id="@+id/translator_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/translator_none" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/translator_none" android:textColor="#FFFFFF" />
                <RadioButton android:id="@+id/translator_claude" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/translator_claude" android:textColor="#FFFFFF" />
                <RadioButton android:id="@+id/translator_deepl" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/translator_deepl" android:textColor="#FFFFFF" />
                <RadioButton android:id="@+id/translator_papago" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/translator_papago" android:textColor="#FFFFFF" />
            </RadioGroup>

            <EditText
                android:id="@+id/api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/api_key_hint"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/api_secret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/papago_secret_hint"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:textColor="#FFFFFF"
                android:textColorHint="#777777"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/translator_help"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hangul_mode"
                android:textColor="#CCCCCC" />

            <RadioGroup
                android:id="@+id/mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/mode_pronunciation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_pronunciation"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/mode_official"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/mode_official"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <TextView
                android:id="@+id/offset_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#CCCCCC" />

            <SeekBar
                android:id="@+id/offset_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offset_help"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/track_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#AAAAAA" />

    <ListView
        android:id="@+id/lyric_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />
</LinearLayout>
